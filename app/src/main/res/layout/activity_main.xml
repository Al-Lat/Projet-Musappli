<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical"
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnBackground"
    android:paddingHorizontal="10dp"
    android:paddingTop="10dp"

    tools:context=".MainActivity"
    >

    <LinearLayout
        android:layout_weight="0.18"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="10dp"
        android:orientation="horizontal"
        >

        <Button
            android:id="@+id/header_allSongs"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/menu_button"
            app:backgroundTint="@null"
            android:textColor="?attr/textFillColor"

            android:text="@string/menu_all_songs"/>

        <Button
            android:id="@+id/header_playlists"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/menu_button"
            app:backgroundTint="@null"
            android:textColor="?attr/textFillColor"
            android:text="@string/menu_playlist"/>

        <Button
            android:id="@+id/header_history"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/menu_button"
            app:backgroundTint="@null"
            android:textColor="?attr/textFillColor"
            android:text="@string/menu_history"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:visibility="visible"
        android:id="@+id/recyclerViewSongs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_song" />

    <TextView
        android:visibility="gone"
        android:id="@+id/main_textView_noSongs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:text="@string/no_songs_found"
        android:textColor="?attr/textFillColor"
        android:textStyle="bold"
        android:textSize="25sp"
        android:gravity="center"

        />

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.25"
        android:orientation="horizontal"
        android:layout_marginVertical="10dp"

        android:gravity="center"

        app:layout_constraintBottom_toBottomOf="parent"
        >

        <ImageButton

            android:id="@+id/importButton"
            android:layout_marginHorizontal="3dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"

            android:src="@drawable/ic_add"
            android:background="@drawable/menu_add_button"
            app:tint="?attr/textFillColor"
            android:contentDescription="@string/import_button_text"

            />
    </LinearLayout>






</LinearLayout>
