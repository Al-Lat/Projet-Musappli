<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mes Playlists"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/textFillColor"
        android:padding="8dp" />

    <TextView
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center"
        android:text="@string/no_playlist_found"
        android:textSize="18sp"
        android:textColor="?attr/textFillColor"
        android:padding="8dp" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPlaylists"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:visibility="visible"
        tools:itemCount="5"
        tools:listitem="@layout/item_playlist_preview"

        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:gravity="center"
        >

        <Button
            android:id="@+id/buttonCancelAddToPlaylist"
            android:layout_marginHorizontal="5dp"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="start"

            android:text="@string/cancel"
            android:textColor="?attr/textFillColor"

            />

        <Button
            android:id="@+id/buttonCreateNewPlaylist"
            android:layout_marginHorizontal="5dp"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="end"

            android:text="@string/create_new_playlist"
            android:textColor="?attr/textFillColor"

            />

    </LinearLayout>

</LinearLayout>