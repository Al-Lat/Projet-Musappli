<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/colorPrimary"

        >



        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="5dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?attr/colorPrimary"
            >

            <TextView
                android:id="@+id/playlistTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:text="Playlist Title"
                android:textColor="?attr/reverseTextColor"
                android:background="?attr/colorPrimary"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:id="@+id/playlistDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="Crée le: 01/01/2023"
                    android:textColor="?attr/reverseTextColor"
                    android:background="?attr/colorPrimary"
                    />

                <TextView
                    android:id="@+id/playlistSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="999 Morceaux"
                    android:textColor="?attr/reverseTextColor"
                    android:background="?attr/colorPrimary"
                    />


            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonBurgerPlaylist"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/menuburger"
            app:tint="?attr/reverseTextColor"
            android:contentDescription="Options" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
