<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="22dp"
    android:paddingHorizontal="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ask_new_playlist_name"
        android:textSize="17sp"
        android:textColor="?attr/textFillColor"/>

    <TextView
        android:id="@+id/errorTextView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ERROR_MESSAGE_PREVIEW"
        android:textSize="17sp"
        android:textColor="@color/redWarning"
        android:background="@color/black"
        />

    <EditText
        android:id="@+id/playlistNameInput"
        android:layout_width="match_parent"
        android:minHeight="48dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"

        android:hint="@string/ask_new_playlist_name_placeholder_text"
        android:text=""
        android:inputType="text"
        android:textColor="?attr/textFillColor"
        android:background="@drawable/text_input_background"

        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingVertical="5dp"
        >

        <Button
            android:id="@+id/buttonCancel"
            android:layout_marginHorizontal="5dp"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="end"

            android:text="@string/cancel"
            android:textColor="?attr/textFillColor"

            />

        <Button
            android:id="@+id/buttonConfirm"
            android:layout_marginHorizontal="5dp"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="end"

            android:text="@string/confirm"
            android:textColor="?attr/textFillColor"

            />



    </LinearLayout>

</LinearLayout>