<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/importButtonLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorOnBackground"
    android:paddingHorizontal="0dp"
    android:paddingVertical="8dp"
    android:gravity="center"
    android:visibility="visible">

    <!-- Ligne de séparation avec le corps de la vue -->
    <View
        android:id="@+id/footerDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/background_standard_no_border" />

    <!-- Conteneur sous le divider avec un padding horizontal de 15dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="15dp">

        <!-- Current song title -->
        <TextView
            android:id="@+id/currentSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/textColor"
            android:textSize="13sp"
            android:visibility="gone" />


        <!-- Playback SeekBar -->
        <SeekBar
            android:id="@+id/playbackSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:paddingHorizontal="8dp"
            android:progress="0"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/textColor"
            android:progressBackgroundTint="?attr/textColor" />

        <!-- Playback Time Text -->
        <TextView
            android:id="@+id/playbackTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/textColor"
            android:textSize="13sp"
            android:singleLine="true"
            android:text="@string/default_time_format" />

        <!-- Button bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <!-- Espaceur gauche pour équilibrer le bouton replay et centrer play/pause -->
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="15dp"
                android:visibility="invisible" />

            <!-- Previous Song Button -->
            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="15dp"
                android:src="@drawable/ic_skip_previous"
                android:background="@drawable/background_menu_button"
                app:tint="?attr/reverseTextColor"
                android:visibility="invisible"
                android:contentDescription="@string/previous_song_button_text" />

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/background_menu_button"
                app:tint="?attr/reverseTextColor"
                android:contentDescription="@string/play_pause_button_text" />

            <!-- Next Song Button -->
            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="15dp"
                android:src="@drawable/ic_skip_next"
                android:background="@drawable/background_menu_button"
                app:tint="?attr/reverseTextColor"
                android:visibility="invisible"
                android:contentDescription="@string/next_song_button_text" />

            <!-- Replay Song Button -->
            <ImageButton
                android:id="@+id/replayButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="15dp"
                android:src="@drawable/selector_replay_icon"
                android:background="@drawable/selector_replay_background"
                app:tint="?attr/reverseTextColor"
                android:contentDescription="@string/replay_button_off_text" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
