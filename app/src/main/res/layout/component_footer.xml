<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/importButtonLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorOnBackground"
    android:paddingHorizontal="15dp"
    android:paddingVertical="8dp"
    android:gravity="center">

    <!-- Ligne de séparation avec le corps de la vue -->
    <View
        android:id="@+id/footerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/textFillColor"
        android:alpha="0.3" />

    <!-- Playback SeekBar -->
    <SeekBar
        android:id="@+id/playbackSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:paddingHorizontal="8dp"
        android:progress="0"
        android:progressTint="?attr/textFillColor"
        android:thumbTint="?attr/textFillColor"
        android:progressBackgroundTint="?attr/textFillColor" />

    <!-- Button bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <!-- Previous Song Button -->
        <ImageButton
            android:id="@+id/previousButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_skip_previous"
            android:background="@drawable/menu_add_button"
            app:tint="?attr/textFillColor"
            android:visibility="gone"
            android:contentDescription="@string/previous_song_button_text" />

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/menu_add_button"
            app:tint="?attr/textFillColor"
            android:contentDescription="@string/play_pause_button_text" />

        <!-- Next Song Button -->
        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_skip_next"
            android:background="@drawable/menu_add_button"
            app:tint="?attr/textFillColor"
            android:visibility="gone"
            android:contentDescription="@string/next_song_button_text" />

        <!-- Playback Time Text -->
        <TextView
            android:id="@+id/playbackTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="?attr/textFillColor"
            android:textSize="13sp"
            android:singleLine="true"
            android:text="@string/default_time_format" />

        <!-- Current song title -->
        <TextView
            android:id="@+id/currentSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/textFillColor"
            android:textSize="13sp"
            android:visibility="gone" />

        <View
            android:id="@+id/footerSpacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Import Button -->
        <ImageButton
            android:id="@+id/importButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/menu_add_button"
            app:tint="?attr/textFillColor"
            android:contentDescription="@string/import_button_text" />

    </LinearLayout>

</LinearLayout>
