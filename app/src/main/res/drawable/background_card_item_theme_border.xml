<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Couche de bordure (fond) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/cardItemBorderColor" />
            <corners android:radius="0dp" />
        </shape>
    </item>

    <!-- Couche de contenu (recouvre la bordure à gauche et à droite pour ne la conserver qu'en haut et en bas) -->
    <item
        android:top="2dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOnBackground" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
